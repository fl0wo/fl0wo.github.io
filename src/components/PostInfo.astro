---
import { contentSlug, SeriesGroup } from '~/content-utils'
import { render, type CollectionEntry } from 'astro:content'
import ArticleMeta from '~/components/ArticleMeta.astro'
import { defaultLang, type Lang } from '~/i18n'

interface Props {
  post: CollectionEntry<'posts'>
  lang?: Lang
  class?: string
}

const { post, lang = defaultLang, class: className } = Astro.props
const { remarkPluginFrontmatter } = await render(post)
const { minutesRead } = remarkPluginFrontmatter
let badge: { label: string; href: string } | undefined
if (post.data.series) {
  const series = (await SeriesGroup.build(lang)).match(post.data.series)
  if (!series) {
    // This should never happen if the series data is correct
    throw new Error(`Series "${post.data.series}" not found`)
  }
  const seriesPostNumber = series.entries.findIndex((p) => contentSlug(p) === contentSlug(post)) + 1
  badge = { label: `${series.title} ${seriesPostNumber} / ${series.entries.length}`, href: series.url }
}
---

<ArticleMeta
  class={className}
  date={post.data.published}
  author={post.data.author}
  minutesRead={minutesRead}
  badge={badge}
/>
