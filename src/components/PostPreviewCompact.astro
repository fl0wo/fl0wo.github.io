---
import type { CollectionEntry } from 'astro:content'
import ArchiveRow from '~/components/ArchiveRow.astro'
import { contentSlug } from '~/content-utils'
import { defaultLang, routePath, type Lang } from '~/i18n'

interface Props {
  post: CollectionEntry<'posts'>
  lang?: Lang
}

const { post, lang = defaultLang } = Astro.props
---

<ArchiveRow
  title={post.data.title}
  href={routePath(lang, { type: 'post', slug: contentSlug(post) })}
  date={post.data.published}
/>
